# Variables de entorno — copiar este archivo como .env y completar los valores
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore)

# PostgreSQL — Railway lo completa automáticamente en producción
DATABASE_URL=postgresql://usuario:contraseña@localhost:4000/motel23saas

# JWT — usa una clave larga y aleatoria en producción (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga

# Entorno (development | production)
NODE_ENV=development

# Puerto (Railway lo asigna automáticamente en producción)
PORT=3001
